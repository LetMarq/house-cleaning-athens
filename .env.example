# Template: copy to .env and fill in. The .env file is ignored by Git.
# On Vercel, paste the content of your .env under Settings → Environment Variables.

# People in the rotation (the number is the order)
PERSON_1_NAME=Name One
PERSON_1_EMAIL=person1@email.com
PERSON_2_NAME=Name Two
PERSON_2_EMAIL=person2@email.com
PERSON_3_NAME=Name Three
PERSON_3_EMAIL=person3@email.com

# Gmail account that sends the reminders
GMAIL_USER=youremail@gmail.com
# Google app password (16 letters) — NOT your regular Gmail password
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Any long random text (protects the send endpoint)
CRON_SECRET=replace-with-a-long-random-string

# Optional: the site's address, for the link in the email
SITE_URL=https://house-cleaning.vercel.app
